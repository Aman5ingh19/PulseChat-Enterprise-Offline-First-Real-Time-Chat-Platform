# Backend Environment Configuration
# Copy this file to .env or pass these as environment variables when running Spring Boot

# Server Port
PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/offline_chat_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=chat_user
DB_PASSWORD=chat_password

# JWT Security
# 256-bit secret key encoded in Base64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
